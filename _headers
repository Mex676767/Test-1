/
  Cache-Control: no-cache, must-revalidate

/index.html
  Cache-Control: no-cache, must-revalidate

/release.json
  Cache-Control: no-store

/blast/index.html
  Cache-Control: no-cache, must-revalidate

/app.js
  Cache-Control: no-cache, must-revalidate

/style.css
  Cache-Control: no-cache, must-revalidate

/blast/popup.js
  Cache-Control: no-cache, must-revalidate

/blast/web-adapter.js
  Cache-Control: no-cache, must-revalidate

# JS/CSS used to be cached for a year as immutable, keyed only by a hand-written ?v= in index.html. A push that forgot
# to bump it never reached browsers that had cached the old file. They now revalidate (cheap 304) on every load.
